---
import Fact from '../components/Fact.astro';
import LogoPlaceholder from '../components/LogoPlaceholder.astro';
import PageIntro from '../components/PageIntro.astro';
import Placeholder from '../components/Placeholder.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { has } from '../lib/config';

const { capuchins, sspx, homeschoolContact } = site.organizations;
---

<BaseLayout title="Associated Organizations">
  <div class="container section">
    <PageIntro title="Associated Organizations" />

    <section class="org card">
      <LogoPlaceholder organization="Capuchin Friars" />
      <div>
        <h2>Traditional Capuchin Friars Minor</h2>
        <p>
          Saint Francis Mission Chapel is served by the Traditional Capuchin Friars Minor, an
          independent Capuchin-Franciscan community. The Traditional Capuchin Friars Minor live the
          authentic Traditional Capuchin Life according to their 800-year-old traditions and
          liturgical practices.
        </p>
        {has(capuchins) && (
          <p>
            <a href={capuchins.value} rel="noopener">
              <Fact f={capuchins}>Visit the Porziuncola Project</Fact>
            </a>
          </p>
        )}
      </div>
    </section>

    <section class="org card">
      <LogoPlaceholder organization="SSPX" />
      <div>
        <h2>Society of Saint Pius X</h2>
        <p>
          Saint Francis Mission Chapel is affiliated with the Society of Saint Pius X (SSPX), but
          the SSPX does not govern its operations and assumes no legal obligations on its behalf.
          Our priest, Fr. David Mary, is affiliated with the SSPX.
        </p>
        {has(sspx) && (
          <p>
            <a href={sspx.value} rel="noopener">
              <Fact f={sspx}>Visit the SSPX website</Fact>
            </a>
          </p>
        )}
      </div>
    </section>

    <section class="org card">
      <div>
        <h2>Una Voce Tennessee</h2>
        <p>
          Saint Francis Mission Chapel is operated by Una Voce Tennessee, a federally recognized
          501(c)(3) nonprofit organization, doing business as Saint Francis Mission Chapel. Una Voce
          Tennessee belongs to Una Voce, an international federation founded in 1966 in Rome to
          preserve the traditional Roman Mass and restore Latin, Gregorian Chant, and sacred
          polyphony in Catholic liturgy.
        </p>
        <p>
          <a href="/about/una-voce-tennessee/">More about Una Voce Tennessee and its board</a>
        </p>
      </div>
    </section>

    <section class="org card">
      <div>
        <h2>Homeschool Groups</h2>
        <Placeholder what="a short description of local homeschool groups." />
        {has(homeschoolContact) && (
          <p>
            Contact: <Fact f={homeschoolContact} />
          </p>
        )}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .org {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    max-width: 52rem;
  }
  @media (min-width: 40em) {
    .org {
      flex-direction: row;
      align-items: flex-start;
    }
  }
</style>
