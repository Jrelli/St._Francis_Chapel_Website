---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// The chapel address is from the owner (2026-10-27): the site launches once Sunday Mass moves
// there. Hermitage address and times are from the Oct 25, 2026 newsletter.
const locations = [
  {
    name: 'Saint Francis Mission Chapel',
    note: 'Sunday Mass',
    address: ['1921 Sockless Rd', 'Dandridge, TN 37725'],
    directions: [
      'From I-40, take Exit 412.',
      'Go south on Deep Springs Road.',
      'Turn right onto Sockless Road.',
      'The road makes a sharp left curve. The chapel is shortly after it, on your right.',
      'Look for the driveway across from a row of three mailboxes.',
    ],
    times: [
      '9:30 AM: Confession (outside) and the Rosary in Latin (inside)',
      '10:00 AM: High Mass',
    ],
  },
  {
    name: 'Holy Crucifixion Hermitage',
    note: 'Weekday Mass. Father sometimes travels, so please confirm before you go.',
    address: ['696 Hale Brook Road', 'Newport, TN 37821'],
    times: ['8:00 AM: Low Mass, Monday through Saturday'],
  },
];

// Plain links (not embedded maps), so no third-party content loads on this page.
const query = (address: string[]) => encodeURIComponent(address.join(', '));
---

<BaseLayout
  title="Locations & Directions"
  description="Where to find Mass and Confession: addresses and map links."
>
  <div class="container section">
    <PageIntro
      title="Locations & Directions"
      lead="Cell coverage can be spotty on rural roads. Please read the directions before you set out."
    />
    <div class="prose">
      {locations.map((loc, i) => (
        <section class="card location" aria-labelledby={`location-${i}`}>
          <h2 id={`location-${i}`}>{loc.name}</h2>
          {loc.note && <p class="muted">{loc.note}</p>}
          <p class="location__address">
            {loc.address.map((line) => (
              <>
                {line}
                <br />
              </>
            ))}
          </p>
          <ul>
            {loc.times.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          {'directions' in loc && (
            <>
              <h3>Directions</h3>
              <ol class="location__steps">
                {loc.directions.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            </>
          )}
          <p class="location__maps no-print">
            <a href={`https://www.google.com/maps/search/?api=1&query=${query(loc.address)}`}>
              Open in Google Maps
            </a>
            <a href={`https://maps.apple.com/?q=${query(loc.address)}`}>Open in Apple Maps</a>
          </p>
        </section>
      ))}
      <p class="muted">
        Times sometimes change for feast days and the priest's travel. Please check the{' '}
        <a href="/calendar/">calendar</a> before you come.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .location {
    margin-bottom: 1.5rem;
  }
  .location__address {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .location__steps li + li {
    margin-top: 0.35rem;
  }
  .location__maps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: 0;
  }
</style>
