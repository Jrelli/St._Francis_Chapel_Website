---
import AboutNav from '../../components/AboutNav.astro';
import PageIntro from '../../components/PageIntro.astro';
import PeopleList from '../../components/PeopleList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { staffGroups } from '../../lib/staff';
---

<BaseLayout title="Staff" description="The chapel team and Una Voce Tennessee board of directors.">
  <div class="container section">
    <PageIntro eyebrow="About" title="Staff" />
    <AboutNav />
    {staffGroups.map((group) => (
      <section class="staff-group" aria-labelledby={`group-${group.id}`}>
        <h2 id={`group-${group.id}`}>{group.title}</h2>
        <PeopleList people={group.people} />
        {group.id === 'una-voce-board' && (
          <p class="staff-group__more">
            <a href="/about/una-voce-tennessee/">About Una Voce Tennessee</a>
          </p>
        )}
      </section>
    ))}
  </div>
</BaseLayout>

<style>
  .staff-group + .staff-group {
    margin-top: 2.5rem;
  }
  .staff-group__more {
    margin-top: 1rem;
  }
</style>
