---
import AboutNav from '../../components/AboutNav.astro';
import PageIntro from '../../components/PageIntro.astro';
import { Content as LetterToBishop } from '../../data/letters/2026-09-28-letter-to-bishop-beckman.md';
// Drafted from the mission's own updates (TLM Respecter Substack, Oct 1 and Oct 14, 2026).
import { Content as OurStory } from '../../data/our-story.md';
import BaseLayout from '../../layouts/BaseLayout.astro';

// The Diocese's public notice, reproduced unaltered as a PDF in public/documents/.
const dioceseNotice = {
  href: '/documents/2026-10-02-diocese-of-knoxville-notice.pdf',
  size: '570 KB',
};
---

<BaseLayout
  title="Our Story"
  description="How Saint Francis Mission Chapel began, including our letter to Bishop Beckman."
>
  <div class="container section">
    <PageIntro eyebrow="About" title="Our Story" />
    <AboutNav />
    <div class="prose">
      <section aria-labelledby="history-heading">
        <h2 id="history-heading" class="first-heading">
          How the Mission Began
        </h2>
        <OurStory />
      </section>

      <section aria-labelledby="letter-heading">
        <h2 id="letter-heading">Letter to Bishop Beckman</h2>
        <p class="muted">
          Letter from Saint Francis Mission Chapel to His Excellency, the Most Reverend Mark
          Beckman, Bishop of Knoxville. Sent September 28, 2026.
        </p>
        <article class="letter" aria-label="Letter to Bishop Beckman">
          <LetterToBishop />
        </article>
      </section>

      <section aria-labelledby="notice-heading">
        <h2 id="notice-heading">The Response from the Diocese of Knoxville</h2>
        <p>
          On October 2, 2026, the Diocese of Knoxville issued a public Notice to the Faithful
          concerning the mission. It is reproduced here in full.
        </p>
        <p>
          <a class="button button--outline" href={dioceseNotice.href}>
            Read the Diocese’s notice <span class="muted-inline">(PDF, {dioceseNotice.size})</span>
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  h2 {
    margin-top: 2.5rem;
  }
  h2.first-heading {
    margin-top: 0.5rem;
  }

  /* The letter is set like a printed letter: paper card, generous margins. */
  .letter {
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 4px solid var(--gold);
    border-radius: var(--radius);
    padding: 1.5rem 1.25rem;
  }
  .letter :global(p:last-child) {
    margin-bottom: 0;
  }

  .muted-inline {
    font-weight: 400;
  }

  @media (min-width: 40em) {
    .letter {
      padding: 2.25rem 2.5rem;
    }
  }
</style>
