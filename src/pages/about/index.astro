---
import { Image } from 'astro:assets';
import engraving from '../../assets/art/engraving.png';
import AboutNav from '../../components/AboutNav.astro';
import Fact from '../../components/Fact.astro';
import PageIntro from '../../components/PageIntro.astro';
import { site } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { has } from '../../lib/config';

const sections = [
  {
    href: '/about/our-story/',
    title: 'Our Story',
    text: 'How the mission began, including our letter to Bishop Beckman.',
  },
  {
    href: '/about/una-voce-tennessee/',
    title: 'Una Voce Tennessee',
    text: 'The nonprofit that operates the chapel, and its board of directors.',
  },
  {
    href: '/about/staff/',
    title: 'Staff',
    text: 'Our chapel team and the Una Voce Tennessee board.',
  },
  {
    href: '/about/organizations/',
    title: 'Associated Organizations',
    text: 'The Society of Saint Pius X, the Traditional Capuchin Friars Minor, and more.',
  },
  {
    href: '/about/first-visit/',
    title: 'Visiting for the First Time',
    text: 'What to expect at the Traditional Latin Mass, and how to prepare.',
  },
  { href: '/about/faq/', title: 'Frequently Asked Questions', text: 'Common questions, answered.' },
];
---

<BaseLayout
  title="About"
  description="Who we are: Saint Francis Mission Chapel, Una Voce Tennessee, and our associated organizations."
>
  <div class="container section">
    <PageIntro title="About the Chapel" />
    <AboutNav />

    <div class="about-intro">
      <div class="prose">
        {has(site.description) && (
          <p class="lead">
            <Fact f={site.description} />
          </p>
        )}

        <h2>Our Mission</h2>
        <p>
          Our mission is to preserve and promote the Traditional Catholic Faith through the Holy
          Sacrifice of the Mass, the traditional sacraments, and the timeless teachings of Holy
          Mother Church. We strive to foster a faithful Catholic community rooted in prayer,
          reverence, and devotion, passing on the treasures of our Faith to future generations for
          the greater glory of God and the salvation of souls.
        </p>
        <p>
          <a href="/about/mission-statement/">Read our full mission statement</a>
        </p>

        <h2>How Our Mission Is Organized</h2>
        <p>
          Saint Francis Mission Chapel is affiliated with the Society of Saint Pius X (SSPX), but
          the SSPX does not govern its operations and assumes no legal obligations on its behalf.
          Our priest, Fr. David Mary, is affiliated with the SSPX.
        </p>
        <p>
          A mission chapel is one where a priest of the Society does not live on site, but is cared
          for by a priest from outside an SSPX priory.
        </p>
        <p>
          Saint Francis Mission Chapel is served by the Traditional Capuchin Friars Minor, an
          independent Capuchin-Franciscan community. The Traditional Capuchin Friars Minor live the
          authentic Traditional Capuchin Life according to their 800-year-old traditions and
          liturgical practices.
        </p>
        <p>
          Saint Francis Mission Chapel is operated by{' '}
          <a href="/about/una-voce-tennessee/">Una Voce Tennessee</a>, a federally recognized
          501(c)(3) nonprofit organization, doing business as Saint Francis Mission Chapel.
        </p>
      </div>
      <Image
        src={engraving}
        alt="Engraving of Saint Francis of Assisi with arms raised, bearing the stigmata"
        widths={[240, 480]}
        sizes="240px"
        class="about-intro__art"
      />
    </div>

    <h2 class="cards-heading">Learn More</h2>
    <ul class="about-cards" role="list">
      {sections.map((s) => (
        <li class="card">
          <h3>
            <a href={s.href}>{s.title}</a>
          </h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .about-intro {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  .lead {
    font-size: 1.15rem;
  }
  .about-intro h2 {
    margin-top: 1.75rem;
  }
  /* Decorative on wide screens only, so phones get straight to the text. */
  .about-intro__art {
    display: none;
    width: 220px;
    height: auto;
  }

  .cards-heading {
    margin-top: 2.5rem;
  }
  .about-cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  .about-cards h3 {
    font-size: 1.4rem;
  }
  .about-cards h3 a {
    color: var(--accent-text);
  }
  .about-cards p {
    margin: 0;
  }
  @media (min-width: 40em) {
    .about-cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .about-intro {
      grid-template-columns: 1fr auto;
      gap: 3rem;
    }
    .about-intro__art {
      display: block;
    }
    .about-cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
