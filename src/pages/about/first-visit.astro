---
// The text lives in src/data/first-visit.md, from the chapel's "Visiting for the First Time -
// Website text" Google Doc (2026-11-02). The jump links are built from its headings.
import AboutNav from '../../components/AboutNav.astro';
import PageIntro from '../../components/PageIntro.astro';
import { Content as FirstVisit, getHeadings } from '../../data/first-visit.md';
import BaseLayout from '../../layouts/BaseLayout.astro';

const contents = getHeadings().filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title="Visiting for the First Time"
  description="What to know before your first visit to the Traditional Latin Mass at Saint Francis Mission Chapel."
>
  <div class="container section">
    <PageIntro
      eyebrow="About"
      title="Visiting for the First Time"
      lead="An Introduction to the Traditional Latin Mass at Saint Francis Mission Chapel"
    />
    <AboutNav />
    <div class="prose first-visit">
      <p>
        See <a href="/">Mass and Confession times</a> and <a href="/locations/">directions</a>. Cell
        coverage can be spotty, so please read the written directions before you set out.
      </p>
      <nav class="card contents no-print" aria-labelledby="contents-heading">
        <h2 id="contents-heading">On This Page</h2>
        <ul role="list">
          {contents.map((h) => (
            <li class:list={{ contents__sub: h.depth === 3 }}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
      <FirstVisit />
    </div>
  </div>
</BaseLayout>

<style>
  .contents {
    margin-block: 1.5rem 2rem;
  }
  .contents h2 {
    margin-top: 0;
    font-size: 1.4rem;
  }
  .contents ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contents li + li {
    margin-top: 0.35rem;
  }
  .contents__sub {
    padding-left: 1.25rem;
  }
  /* The headings below come from Markdown, so scoped styles need :global to reach them. */
  .first-visit :global(h2) {
    margin-top: 2.5rem;
  }
  .first-visit :global(h3) {
    margin-top: 2rem;
  }
  .first-visit :global(h4) {
    margin: 1.5rem 0 0.5rem;
    font-size: 1.05rem;
  }
  .first-visit .contents h2 {
    margin-top: 0;
  }
</style>
