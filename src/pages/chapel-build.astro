---
// Project facts below come from the mission's own updates (TLM Respecter Substack, Oct 1 and
// Oct 14, 2026). Figures still awaiting confirmation are listed in CONTENT_TO_CONFIRM.md.
import aerialPhoto from '../assets/photos/aerial-property.jpg';
import interiorRendering from '../assets/photos/chapel-rendering-interior.jpg';
import sitePlan from '../assets/photos/site-plan.jpg';
import ConstructionGallery from '../components/ConstructionGallery.astro';
import Fact from '../components/Fact.astro';
import Figure from '../components/Figure.astro';
import FundraisingProgress from '../components/FundraisingProgress.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { has } from '../lib/config';
const walkthroughVideo = 'https://www.youtube.com/watch?v=VcZQ7ViqMGA';
---

<BaseLayout
  title="Chapel Build"
  description="Building a permanent chapel for the Traditional Latin Mass in East Tennessee."
>
  <div class="container section">
    <PageIntro title="Chapel Build" />
    <div class="prose">
      {has(site.chapelBuildBlurb) && (
        <p class="lead">
          <Fact f={site.chapelBuildBlurb} />
        </p>
      )}
      <FundraisingProgress />
      <p>
        <a class="button" href="/donate/">
          Donate to the chapel build
        </a>
      </p>
    </div>

    <div class="build-hero">
      <Figure
        src={interiorRendering}
        alt="Concept rendering of the chapel interior: wooden pews facing a white and gold high altar with a crucifix, a communion rail, statues of Our Lady and Saint Joseph, stained-glass windows, and the Stations of the Cross along the walls"
        caption="Concept rendering of the finished sanctuary."
        sizes="(min-width: 64em) 56rem, 100vw"
      />
    </div>

    <section aria-labelledby="project-heading" class="prose">
      <h2 id="project-heading">The Project</h2>
      <p>
        In June 2026, the mission bought five acres of land in Jefferson County, Tennessee. The
        property includes a large barn, which we are converting into a chapel complete with a
        sanctuary, a community center, and classrooms.
      </p>
      <p>
        Volunteers have been cleaning and landscaping the grounds and framing the inside of the
        barn. Our goal is to finish the sanctuary in time to offer Holy Mass in it during Advent.
      </p>
      <p>
        Our fundraising goal is <strong>$300,000</strong>. Until the chapel is ready, Father David
        Mary continues to offer the Traditional Latin Mass every Sunday. See the{' '}
        <a href="/">Mass times</a>.
      </p>
    </section>

    <section aria-labelledby="property-heading">
      <h2 id="property-heading">The Property</h2>
      <div class="property-figures">
        <Figure
          src={aerialPhoto}
          alt="Aerial view of the mission property: wooded hills along a country road, with mountains on the horizon"
          caption="The five-acre property from the air."
          sizes="(min-width: 48em) 45vw, 100vw"
          enlarge
        />
        <Figure
          src={sitePlan}
          alt="Illustrated site plan of the property: a driveway from the road leads to parking beside the chapel, with a lawn in front and a Marian grotto in the woods"
          caption="Concept site plan: the chapel, parking, driveway, and a Marian grotto."
          sizes="(min-width: 48em) 45vw, 100vw"
          enlarge
        />
      </div>
    </section>

    <section aria-labelledby="progress-heading">
      <h2 id="progress-heading">Construction Progress</h2>
      {/* A plain link, not an embedded player: embeds load YouTube's cookies and trackers. */}
      <p class="video-link">
        <a class="button button--outline" href={walkthroughVideo} rel="noopener">
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M4 2.5v11l9-5.5z" fill="currentColor" />
          </svg>
          Watch the construction walkthrough
          <span class="visually-hidden"> (video on YouTube)</span>
        </a>
      </p>
      <p class="prose muted">Select a photo to see it larger.</p>
      <ConstructionGallery />
    </section>
  </div>
</BaseLayout>

<style>
  .video-link .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lead {
    font-size: 1.15rem;
  }
  h2 {
    margin-top: 2.5rem;
  }
  .build-hero {
    max-width: 56rem;
    margin-top: 1.5rem;
  }
  .property-figures {
    display: grid;
    gap: 1.5rem;
  }
  @media (min-width: 48em) {
    .property-figures {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
</style>
