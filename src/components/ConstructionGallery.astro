---
/**
 * Photo grid built from every image in src/assets/photos/construction/ (filename order).
 * Alt text comes from src/data/construction-photos.yaml. Each thumbnail links to a larger
 * copy of the photo, so no JavaScript lightbox is needed.
 */
import { z } from 'astro/zod';
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';
import raw from '../data/construction-photos.yaml?raw';
import { parseYamlData } from '../lib/yaml-data';

// import.meta.glob is Vite's way to import every file matching a pattern at build time.
const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/construction/*.{jpg,jpeg,png,webp}',
  { eager: true },
);
const altText = parseYamlData(
  raw ?? '',
  z
    .record(z.string(), z.string())
    .nullable()
    .transform((v) => v ?? {}),
  'src/data/construction-photos.yaml',
);

const photos = await Promise.all(
  Object.keys(files)
    .sort()
    .map(async (path) => {
      const src = files[path]!.default;
      const name = path.split('/').pop() ?? '';
      const large = await getImage({ src, width: Math.min(src.width, 1600), format: 'jpeg' });
      return { src, large: large.src, alt: altText[name] ?? 'Construction progress at the chapel' };
    }),
);
---

{photos.length > 0 && (
  <ul class="gallery" role="list">
    {photos.map((photo) => (
      <li>
        <a href={photo.large} class="gallery__link">
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[320, 480, 720]}
            sizes="(min-width: 64em) 17rem, (min-width: 40em) 30vw, 46vw"
            class="gallery__img"
            loading="lazy"
          />
          <span class="visually-hidden"> (open larger photo)</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.6rem;
  }
  .gallery__link {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--rule);
  }
  .gallery__img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    height: auto;
    object-fit: cover;
  }
  .gallery__link:hover .gallery__img {
    opacity: 0.9;
  }
  @media (min-width: 40em) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.9rem;
    }
  }
  @media (min-width: 64em) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
