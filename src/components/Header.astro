---
/**
 * Site header with the main navigation.
 *
 * Mobile menu, progressive enhancement:
 * - Without JavaScript, the nav links are simply always visible (nothing is hidden).
 * - With JavaScript, CSS `@media (scripting: enabled)` collapses the list behind a Menu button
 *   from the very first paint, so there's no flash of an open menu and no inline script.
 *   menu.ts toggles aria-expanded; CSS shows the list when it's "true".
 */
import { Image } from 'astro:assets';
// The brown seal crop, back by the owner's choice (2026-10-29). The black-and-white
// engraving version is in src/assets/brand/francis-mark.png.
import sealMark from '../assets/brand/seal-mark.png';
import { mainNav } from '../config/nav';
import { site } from '../config/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/">
      <Image
        src={sealMark}
        alt=""
        width={56}
        height={56}
        densities={[1, 2]}
        class="brand__seal"
        loading="eager"
      />
      <span class="brand__name">{site.name.value}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="menu-toggle__icon" aria-hidden="true"></span>
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul role="list">
        {mainNav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="site-nav__donate">
          <a class="button" href="/donate/">
            Donate
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import '../scripts/menu';
</script>

<style>
  .site-header {
    background: var(--header-bg);
    border-bottom: 3px solid var(--header-border);
  }

  .site-header__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 0.75rem;
    padding-block: 0.6rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* Take the row's free space but shrink (and wrap the name) so Menu stays beside it. */
    flex: 1 1 0;
    min-width: 0;
    text-decoration: none;
    color: var(--header-brand);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.1;
  }

  .brand__seal {
    width: 44px;
    height: 44px;
    flex: none;
    /* Blends the engraving's white paper into a light header; dark headers show it as a disc. */
    mix-blend-mode: var(--header-seal-blend);
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.5rem 0.8rem;
    font: inherit;
    font-weight: 600;
    color: var(--dark);
    background: var(--bg);
    border: 2px solid var(--dark);
    border-radius: var(--radius);
    cursor: pointer;
  }

  /* Three-line "hamburger" drawn with borders. */
  .menu-toggle__icon,
  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    position: relative;
  }
  .menu-toggle__icon::before,
  .menu-toggle__icon::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-toggle__icon::before {
    top: -6px;
  }
  .menu-toggle__icon::after {
    top: 6px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::before {
    top: 0;
    transform: rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .site-nav {
    width: 100%;
  }

  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .site-nav a:not(.button) {
    display: block;
    padding: 0.75rem 0.25rem;
    border-top: 1px solid var(--header-rule);
    color: var(--header-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav a:not(.button):hover,
  .site-nav a[aria-current='page'] {
    color: var(--header-current);
    text-decoration: underline;
    text-decoration-color: var(--header-current-line);
    text-decoration-thickness: 2px;
  }

  .site-nav__donate {
    padding-block: 0.75rem;
    border-top: 1px solid var(--header-rule);
  }
  .site-nav__donate .button {
    background: var(--header-button-bg);
    color: var(--header-button-ink);
  }

  /* Phones and tablets with JavaScript: collapse behind the Menu button. */
  @media (scripting: enabled) and (max-width: 63.99em) {
    .menu-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
    }
    .menu-toggle[aria-expanded='true'] + .site-nav {
      display: block;
    }
  }

  /* Desktop: one row. */
  @media (min-width: 64em) {
    .site-header__bar {
      flex-wrap: nowrap;
    }
    .brand {
      max-width: none;
      font-size: 1.5rem;
    }
    .brand__seal {
      width: 64px;
      height: 64px;
    }
    .site-nav {
      width: auto;
    }
    .site-nav ul {
      flex-direction: row;
      align-items: center;
      gap: 0.25rem 1.1rem;
    }
    .site-nav a:not(.button) {
      border-top: 0;
      padding: 0.5rem 0;
      font-size: 0.95rem;
    }
    .site-nav__donate {
      border-top: 0;
      padding: 0 0 0 0.25rem;
    }
  }
</style>
