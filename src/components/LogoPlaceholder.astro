---
/**
 * Stands in for another organization's logo. DO NOT replace with a real logo until we
 * have written permission to use it (tracked in CONTENT_TO_CONFIRM.md).
 */
interface Props {
  organization: string;
}

const { organization } = Astro.props;
---

<div class="logo-placeholder" role="img" aria-label={`${organization} logo not shown`}>
  <span aria-hidden="true">
    {organization}
    <br />
    logo pending permission
  </span>
</div>

<style>
  .logo-placeholder {
    width: 8rem;
    height: 8rem;
    flex: none;
    display: grid;
    place-items: center;
    text-align: center;
    padding: 0.5rem;
    border: 2px dashed var(--gold);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.3;
  }
</style>
