---
/**
 * An image with a caption. With `enlarge`, the image links to a larger copy (useful for
 * plans with small labels), the same no-JavaScript approach as the construction gallery.
 */
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  /** Responsive `sizes` hint: how wide the image is shown at each breakpoint. */
  sizes: string;
  enlarge?: boolean;
}

const { src, alt, caption, sizes, enlarge = false } = Astro.props;
const widths = [480, 800, 1200, src.width].filter(
  (w, i, all) => w <= src.width && all.indexOf(w) === i,
);
const large = enlarge
  ? await getImage({ src, width: Math.min(src.width, 2000), format: 'jpeg' })
  : null;
---

<figure class="figure">
  {large ? (
    <a href={large.src} class="figure__link">
      <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
      <span class="visually-hidden"> (open larger image)</span>
    </a>
  ) : (
    <Image src={src} alt={alt} widths={widths} sizes={sizes} loading="lazy" />
  )}
  <figcaption>
    {caption}
    {large && <span class="figure__hint"> Select the image to enlarge it.</span>}
  </figcaption>
</figure>

<style>
  .figure {
    margin: 0;
  }
  .figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }
  .figure__link {
    display: block;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
</style>
