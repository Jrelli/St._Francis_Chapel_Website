---
/** Standard page heading with an optional lead paragraph. */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-intro">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lead && <p class="page-intro__lead">{lead}</p>}
</header>

<style>
  .page-intro {
    max-width: var(--measure);
    margin-bottom: 1.5rem;
  }
  .page-intro__lead {
    font-size: 1.15rem;
    color: var(--ink-muted);
  }
</style>
