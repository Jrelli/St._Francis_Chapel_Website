---
/**
 * A grid of staff cards (Staff page, Una Voce Tennessee board). Until photos are added, each
 * card shows a line-drawn budded cross with "Picture to come".
 */
import type { StaffGroup } from '../lib/staff';

interface Props {
  people: StaffGroup['people'];
}

const { people } = Astro.props;
---

<ul class="people" role="list">
  {people.map((person) => (
    <li class="card person">
      <div class="person__photo" aria-hidden="true">
        <svg viewBox="0 0 60 84" class="person__cross" focusable="false">
          <!-- Budded (trefoil) Latin cross in outline, with an inner rule and an INRI board. -->
          <path d="M27 11h6v14h15v6H33v42h-6V31H12v-6h15z" />
          <path class="person__inner" d="M29 13.5h2V27h14.5v2H31v41.5h-2V29H14.5v-2H29z" />
          <circle cx="30" cy="7.5" r="3.5" />
          <circle cx="25.8" cy="10.2" r="2.2" />
          <circle cx="34.2" cy="10.2" r="2.2" />
          <circle cx="8.5" cy="28" r="3.5" />
          <circle cx="11.2" cy="23.8" r="2.2" />
          <circle cx="11.2" cy="32.2" r="2.2" />
          <circle cx="51.5" cy="28" r="3.5" />
          <circle cx="48.8" cy="23.8" r="2.2" />
          <circle cx="48.8" cy="32.2" r="2.2" />
          <rect x="24" y="15" width="12" height="5" rx="0.5" />
          <path d="M16 81c4-5 9-8 14-8s10 3 14 8z" />
        </svg>
        <span>Picture to come</span>
      </div>
      <div>
        <p class="eyebrow">{person.role}</p>
        <p class="person__name">{person.name}</p>
      </div>
    </li>
  ))}
</ul>

<style>
  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .person {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }
  .person__photo {
    flex: none;
    width: 5.5rem;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    background: var(--band);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-muted);
    font-size: 0.7rem;
    line-height: 1.1;
    text-align: center;
  }
  .person__cross {
    width: 2.6rem;
    fill: var(--band);
    stroke: var(--ink-muted);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .person__inner {
    fill: none;
    stroke-width: 0.5;
  }
  .person__name {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }
  @media (min-width: 40em) {
    .people {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .people {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
