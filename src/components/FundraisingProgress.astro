---
/**
 * Chapel-build fundraising progress: the amount raised, a bar toward the goal, and when the
 * total was last updated. Data comes from src/lib/fundraising.ts (the Google Sheet once it's
 * connected, otherwise site.fundraising).
 *
 * The bar is an SVG whose width is set with an attribute, because the CSP forbids inline
 * style="" attributes. The text says everything the bar shows, so the bar is hidden from
 * screen readers.
 */
import { formatDate, parseDateOnly } from '../lib/dates';
import { formatDollars, getFundraising, percentRaised } from '../lib/fundraising';

const funds = await getFundraising();
const percent = percentRaised(funds);
---

<div class="fundraising">
  <p class="fundraising__amount">
    <strong>{formatDollars(funds.raised)}</strong> raised toward our {formatDollars(funds.goal)}{' '}
    goal
  </p>
  <svg class="fundraising__bar" width="100%" height="18" aria-hidden="true" focusable="false">
    <rect class="fundraising__track" x="0" y="0" width="100%" height="18" rx="9" />
    {percent > 0 && (
      <rect class="fundraising__fill" x="0" y="0" width={`${percent}%`} height="18" rx="9" />
    )}
  </svg>
  <p class="fundraising__meta">
    <span>{percent}% of the goal</span>
    {funds.asOf && <span>Updated {formatDate(parseDateOnly(funds.asOf))}</span>}
  </p>
</div>

<style>
  .fundraising {
    max-width: 34rem;
    margin-block: 1rem 1.25rem;
  }
  .fundraising__amount {
    margin: 0 0 0.5rem;
    color: var(--ink-muted);
  }
  .fundraising__amount strong {
    display: block;
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1.1;
    color: var(--accent-text);
  }
  .fundraising__bar {
    display: block;
    overflow: visible;
  }
  .fundraising__track {
    fill: var(--bg);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }
  .fundraising__fill {
    fill: var(--accent);
  }
  .fundraising__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0.4rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-muted);
  }
</style>
