# Copy this file to .env for local development. Never commit .env.
# In production, set these in Cloudflare Pages → Settings → Variables and Secrets.
# Leaving both blank is fine: the site builds with clearly labelled sample events.

# Build-time key. Used only while building; never sent to visitors' browsers
# (Astro only exposes variables that start with PUBLIC_).
# Restrict in Google Cloud Console → APIs & Services → Credentials:
#   API restrictions: Google Calendar API (+ Google Drive API in Phase 2)
#   Application restrictions: None (build servers send no referrer)
GOOGLE_API_KEY=

# Browser key for the live "This week" list. This WILL be visible in page source,
# so it MUST be restricted:
#   API restrictions: Google Calendar API only
#   Website restrictions (HTTP referrers):
#     https://saintfrancischapel.com/*
#     https://*.saintfrancischapel.com/*
#     https://*.pages.dev/*      (narrow to your project, e.g. https://*.sfmc.pages.dev/*)
#     http://localhost:4321/*    (optional, for local testing)
PUBLIC_GOOGLE_CALENDAR_BROWSER_KEY=

# TESTING ONLY. Read this calendar instead of the chapel calendar in src/config/site.ts
# (the ID is in Google Calendar → the calendar's Settings → Integrate calendar).
# Pages show a "Test calendar" note while it's set. Never set it in Cloudflare *Production*.
GOOGLE_CALENDAR_ID=
